    }
  },
  "type": "module",
  "dependencies": {
    "@opentui/core": "^0.5.11",
    "@opentui/react": "^0.5.11",
    "react": "^19.3.0",
    "web-tree-sitter": "0.25.10"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "@types/react": "^19.3.0",
    "tsx": "^4.23.13",
