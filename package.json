    "dev": "node --experimental-ffi ./node_modules/tsx/dist/cli.mjs src/index.tsx",
    "start": "node --experimental-ffi ./node_modules/tsx/dist/cli.mjs src/index.tsx",
    "typecheck": "tsc --noEmit"
