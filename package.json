{
  "name": "@arttiv/dowse",
  "description": "Terminal web browser with AI answers — dowse the web without leaving your terminal",
  "version": "0.2.0",
  "bin": {
    "dowse": "./bin/dowse.mjs"
  },
  "files": ["src", "bin", "README.md", "ROADMAP.md"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arttivhq/dowse.git"
  },
  "homepage": "https://github.com/arttivhq/dowse",
  "bugs": "https://github.com/arttivhq/dowse/issues",
  "keywords": ["terminal", "browser", "tui", "opentui", "search", "ai", "reader"],
  "scripts": {
    "dev": "node --experimental-ffi ./node_modules/tsx/dist/cli.mjs src/index.tsx",
    "start": "node --experimental-ffi ./node_modules/tsx/dist/cli.mjs src/index.tsx",
    "typecheck": "tsc --noEmit",
    "build:exe": "bun ./scripts/build.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.5.1",
      "onFail": "download"
    }
  },
  "type": "module",
  "dependencies": {
    "@opentui/core": "^0.5.11",
    "@opentui/react": "^0.5.11",
    "react": "^19.3.0",
    "tsx": "^4.23.13",
    "web-tree-sitter": "0.25.10"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "@types/react": "^19.3.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=26.4.0"
  }
}
